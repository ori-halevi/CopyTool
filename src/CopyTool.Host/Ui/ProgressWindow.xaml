<Window x:Class="CopyTool.Host.Ui.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyTool"
        Width="640" Height="360"
        MinWidth="520" MinHeight="320"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource OnSurface}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Hand-rolled palette rather than a theme package: one progress window
             does not justify a NuGet dependency, and this keeps the build offline. -->
        <SolidColorBrush x:Key="Surface"      Color="#FF202020"/>
        <SolidColorBrush x:Key="SurfaceAlt"   Color="#FF2B2B2B"/>
        <SolidColorBrush x:Key="OnSurface"    Color="#FFF3F3F3"/>
        <SolidColorBrush x:Key="Muted"        Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="Accent"       Color="#FF4CC2FF"/>
        <SolidColorBrush x:Key="TrackBrush"   Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="Border"       Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="Warning"      Color="#FFFFC83D"/>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smaller and quieter than an action button: a policy chip is a status
             readout you can click, not a command. -->
        <Style x:Key="PolicyChipStyle" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <!-- PART_Track and PART_Indicator are named parts: ProgressBar
                             sizes PART_Indicator itself from Value. Omitting it leaves
                             a bar that renders only its track and never fills. -->
                        <Border CornerRadius="4" ClipToBounds="True"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Paused reads as a colour before it reads as a word, which is why
                 the built-in copy dialog does the same. On the shared style, so the
                 queue rows say it too and not only the job shown in full. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- queue list -->
            <RowDefinition Height="*"/>      <!-- the job shown in full -->
        </Grid.RowDefinitions>

        <!-- Every other job, one line each. Appears only when there is more than
             one, so a single drop looks exactly as it did before. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14"
                    Visibility="{Binding Queue.ShowList, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Queue.Header}" Foreground="{DynamicResource Muted}"
                       FontSize="12" Margin="0,0,0,6"/>
            <!-- A ListBox rather than an ItemsControl: the rows have to be
                 selectable. Selecting one brings it into the detail area below and
                 the pause and cancel buttons act on it, which is the only way to
                 cancel a job waiting its turn without cancelling the one that is
                 running. Selection also brings arrow-key navigation with it. -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                <ListBox ItemsSource="{Binding Queue.Jobs}"
                         SelectedItem="{Binding Queue.Primary, Mode=TwoWay}"
                         MaxHeight="120"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding ShortTitle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- The accent edge sits on the flow-start
                                             side, which under RightToLeft is the
                                             visual right. -->
                                        <Border x:Name="Row" CornerRadius="4"
                                                Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource SurfaceAlt}"/>
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding ShortTitle}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Style="{StaticResource Bar}" Height="3" Margin="0,4,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <!-- Everything below is one job's detail. Bound once here rather than per
             element, so handing the area to a different job is a single change. -->
        <Grid Grid.Row="1" DataContext="{Binding Queue.Primary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- title and banners -->
                <RowDefinition Height="Auto"/>   <!-- bar -->
                <RowDefinition Height="Auto"/>   <!-- stats -->
                <RowDefinition Height="*"/>      <!-- graph + current file -->
                <RowDefinition Height="Auto"/>   <!-- policy chips -->
                <RowDefinition Height="Auto"/>   <!-- actions + counters -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Blocking preflight result: nothing was copied, and the reason is
                     stated instead of a job that silently did nothing. -->
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                        Background="#22FF6B6B" BorderBrush="#FFFF6B6B" BorderThickness="1"
                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BlockedText}" Foreground="#FFFF9A9A" TextWrapping="Wrap"/>
                </Border>

                <!-- Non-fatal findings, stated once up front. -->
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                        Background="#18FFC83D" BorderBrush="#66FFC83D" BorderThickness="1"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding WarningsText}" Foreground="{DynamicResource Warning}"
                               TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Files that did not arrive and that no rule accounts for. The
                     count alone would say "142 skipped" and vanish with the window;
                     the names are the part nothing else can supply. -->
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                        Background="#22FF6B6B" BorderBrush="#66FF6B6B" BorderThickness="1"
                        Visibility="{Binding HasNotCopied, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NotCopiedText}" Foreground="#FFFF9A9A"
                               TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Appears the moment the preflight knows, not after the copy stalls.
                     Everything unaffected keeps copying while this is on screen. -->
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                        Background="#22FFC83D" BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                        Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Style="{StaticResource PolicyChipStyle}"
                                Content="אשר עכשיו" Click="OnElevateClick" Margin="10,0,0,0"
                                IsEnabled="{Binding CanRequestElevation}"
                                Foreground="{DynamicResource Warning}"
                                BorderBrush="{DynamicResource Warning}"/>
                        <TextBlock Text="{Binding ElevationText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Warning}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <ProgressBar Grid.Row="1" Style="{StaticResource Bar}"
                         Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>

            <!-- Numbers and the Hebrew ETA are separate elements: put them in one string
                 and bidi reordering shuffles the Latin runs. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{Binding Numbers}" Foreground="{DynamicResource Muted}"
                           FlowDirection="LeftToRight"/>
                <TextBlock Text="  ·  " Foreground="{DynamicResource Muted}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Eta}" Foreground="{DynamicResource Muted}"/>
            </StackPanel>

            <Grid Grid.Row="3" VerticalAlignment="Center">
                <!-- Throughput over the last few seconds. Scaled to its own peak, so
                     the shape is the message: steady, tailing off, or stalled.
                     FlowDirection is forced left-to-right — time runs one way. -->
                <Border Height="44" VerticalAlignment="Center" Margin="0,4,0,8"
                        FlowDirection="LeftToRight"
                        Visibility="{Binding HasSpeedGraph, Converter={StaticResource BoolToVisibility}}">
                    <!-- Stroke lives in the style, not as an attribute: a local
                         value outranks a setter, and the paused trigger would
                         never win. -->
                    <Polyline Points="{Binding SpeedGraph}" StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              Stretch="Fill" ClipToBounds="True">
                        <Polyline.Style>
                            <Style TargetType="Polyline">
                                <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter Property="Opacity" Value="0.85"/>
                                <Style.Triggers>
                                    <!-- The line is frozen while paused, so it has
                                         to look frozen. Left in the accent colour
                                         it reads as a live copy holding steady. -->
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Warning}"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Polyline.Style>
                    </Polyline>
                </Border>

                <TextBlock Text="{Binding CurrentFile}" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" FontSize="12"
                           VerticalAlignment="Bottom"
                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
            </Grid>

            <!-- One row for every policy. Each chip shows its current value and opens
                 its options on click; a value away from the default is accented, so a
                 changed policy is visible without reading. -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding Chips}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The visual content is a panel, which leaves the button
                             nameless to assistive tech; state it explicitly. -->
                        <Button Style="{StaticResource PolicyChipStyle}" Click="OnChipClick"
                                Tag="{Binding}"
                                AutomationProperties.Name="{Binding Text}"
                                ToolTip="{Binding Text}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Text}"/>
                                <TextBlock Text=" ⌄" Opacity="0.6"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Counters sit next to the actions and appear only when they have
                 something to say. A skip is never silent. -->
            <!-- Two columns, not one cell with two children. Under RightToLeft
                 WPF mirrors the layout axis, so HorizontalAlignment="Left" resolves
                 to the *visual right* — which is where the buttons already are, and
                 the counters were being drawn straight on top of them. Columns make
                 the separation structural instead of depending on getting a mirrored
                 alignment right. -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- actions, at the flow start -->
                    <ColumnDefinition Width="*"/>      <!-- counters, at the far end -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Style="{StaticResource Chip}"
                            Content="{Binding PauseLabel}" Click="OnPauseClick"
                            IsEnabled="{Binding IsRunning}"/>
                    <!-- CanCancel, not IsRunning: the copy stops before the job does,
                         and the phase in between can sit waiting on a permission
                         prompt with no other way out. -->
                    <Button x:Name="CancelButton" Style="{StaticResource Chip}"
                            Content="בטל" Click="OnCancelClick"
                            IsEnabled="{Binding CanCancel}"/>
                    <Button x:Name="CloseButton" Style="{StaticResource Chip}"
                            Content="סגור" Click="OnCloseClick"/>
                </StackPanel>

                <!-- Right, meaning the visual left: the axis is mirrored here. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource Warning}"
                               Margin="0,0,14,0" VerticalAlignment="Center"
                               Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding SkippedText}" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
