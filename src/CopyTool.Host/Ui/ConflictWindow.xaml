<Window x:Class="CopyTool.Host.Ui.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyTool — התנגשויות"
        Width="720" Height="480"
        MinWidth="560" MinHeight="360"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FF202020" Foreground="#FFF3F3F3">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="Surface"    Color="#FF202020"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#FF2B2B2B"/>
        <SolidColorBrush x:Key="Muted"      Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="Accent"     Color="#FF4CC2FF"/>
        <SolidColorBrush x:Key="Border"     Color="#FF3A3A3A"/>

        <!-- One fact about one side of the comparison. The four styles below differ
             only in which flag they watch: the value that wins its axis is set in
             SemiBold, so the thing you are choosing between is legible at a glance
             instead of requiring two numbers to be read and subtracted. This is
             what the built-in Windows copy dialog does with the newer date. -->
        <Style x:Key="Fact" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SourceSize" TargetType="TextBlock" BasedOn="{StaticResource Fact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceIsLarger}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SourceDate" TargetType="TextBlock" BasedOn="{StaticResource Fact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceIsNewer}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DestinationSize" TargetType="TextBlock" BasedOn="{StaticResource Fact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DestinationIsLarger}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DestinationDate" TargetType="TextBlock" BasedOn="{StaticResource Fact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DestinationIsNewer}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="#FFF3F3F3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- bulk actions -->
            <RowDefinition Height="*"/>      <!-- list -->
            <RowDefinition Height="Auto"/>   <!-- clear out the identical ones -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Header}" FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- One answer usually covers everything; deciding fifty files one at a
             time is what makes the built-in dialog exhausting. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="החל על הכל:" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Flat}" Content="החלף" Click="OnAllReplace"/>
            <Button Style="{StaticResource Flat}" Content="דלג"  Click="OnAllSkip"/>
            <Button Style="{StaticResource Flat}" Content="שמור שניהם" Click="OnAllKeepBoth"/>
            <Button Style="{StaticResource Flat}" Content="שמור את החדש" Click="OnAllKeepNewer"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Verdict}" Foreground="{DynamicResource Accent}"
                                               FontSize="12" Margin="0,3,0,4"/>

                                    <!-- Side by side, both directions labelled, so the
                                         choice does not depend on remembering which is which. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Each side: label in Hebrew, facts forced
                                             left-to-right. Size and date are Latin
                                             runs separated by a neutral, and in an
                                             RTL paragraph bidi is free to swap
                                             them — so the date could appear before
                                             the size it belongs to.
                                             Double-click opens the file itself, and
                                             the tooltip is the full path: the name
                                             alone often is not enough to know which
                                             of the two you actually want. -->
                                        <StackPanel Grid.Column="0"
                                                    ToolTip="{Binding SourcePath}"
                                                    MouseLeftButtonDown="OnSideDoubleClick"
                                                    Tag="{Binding SourcePath}"
                                                    Background="Transparent">
                                            <TextBlock Text="מקור" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SourceSizeText}"
                                                           Style="{StaticResource SourceSize}"/>
                                                <TextBlock Text="  ·  " Style="{StaticResource Fact}"
                                                           Foreground="{DynamicResource Muted}"
                                                           Visibility="{Binding HasSourceDate, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding SourceDateText}"
                                                           Style="{StaticResource SourceDate}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    ToolTip="{Binding DestinationPath}"
                                                    MouseLeftButtonDown="OnSideDoubleClick"
                                                    Tag="{Binding DestinationPath}"
                                                    Background="Transparent">
                                            <TextBlock Text="קיים ביעד" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DestinationSizeText}"
                                                           Style="{StaticResource DestinationSize}"/>
                                                <TextBlock Text="  ·  " Style="{StaticResource Fact}"
                                                           Foreground="{DynamicResource Muted}"
                                                           Visibility="{Binding HasDestinationDate, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding DestinationDateText}"
                                                           Style="{StaticResource DestinationDate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource Flat}"
                                        Content="{Binding ChoiceLabel}" Tag="{Binding}"
                                        Click="OnItemChoiceClick" VerticalAlignment="Center"
                                        MinWidth="110" Margin="10,0,0,0"
                                        AutomationProperties.Name="{Binding Name}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Two columns, not one cell with two children. Under RightToLeft WPF
             mirrors the layout axis, so HorizontalAlignment="Left" resolves to the
             *visual right* — where the buttons already are — and the counter was
             being drawn on top of them. -->
        <!-- One tick to clear the files that are already there byte for byte,
             leaving only the conflicts that are really a question. Unticked to
             start with: they are on this list precisely because skipping them
             without saying so is what this used to get wrong. -->
        <CheckBox Grid.Row="3" Margin="2,12,0,0"
                  IsChecked="{Binding SkipIdentical, Mode=TwoWay}"
                  Content="{Binding SkipIdenticalLabel}"
                  Foreground="{DynamicResource Muted}"
                  Cursor="Hand" HorizontalAlignment="Right"
                  Visibility="{Binding HasIdentical, Converter={StaticResource BoolToVisibility}}"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="ApplyButton" Style="{StaticResource Flat}" Content="בצע" Click="OnApply"/>
                <!-- Back, not cancel: this list is reached from the four-answer
                     window, and leaving it returns there rather than abandoning
                     the whole question. -->
                <Button Style="{StaticResource Flat}" Content="חזרה" Click="OnCancel"/>
            </StackPanel>

            <!-- Right, meaning the visual left: the axis is mirrored here. -->
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="14,0,0,0" Foreground="{DynamicResource Muted}">
                <Run Text="ללא החלטה:"/><Run Text=" "/><Run Text="{Binding UndecidedCount, Mode=OneWay}"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
