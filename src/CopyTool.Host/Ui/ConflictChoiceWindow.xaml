<Window x:Class="CopyTool.Host.Ui.ConflictChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyTool — התנגשויות"
        Width="560" SizeToContent="Height"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FF202020" Foreground="#FFF3F3F3">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted"  Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4CC2FF"/>
        <SolidColorBrush x:Key="Border" Color="#FF3A3A3A"/>

        <!-- A full-width row rather than a button in a row of buttons: these are
             four answers to one question, and the eye should run down them. -->
        <Style x:Key="Choice" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF3F3F3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="6" Padding="14,10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF2B2B2B"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Border}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ChoiceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="{Binding Into}" Foreground="{DynamicResource Muted}" FontSize="12"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold"
                   Margin="0,4,0,14" TextWrapping="Wrap"/>

        <!-- Deliberately no IsDefault. Enter must not fire "replace" — the one
             answer here that destroys something. -->
        <Button x:Name="ReplaceButton" Style="{StaticResource Choice}" Click="OnReplaceAll"
                AutomationProperties.Name="החלף את הקבצים ביעד">
            <StackPanel>
                <TextBlock Text="החלף את הקבצים ביעד" Style="{StaticResource ChoiceTitle}"/>
                <TextBlock Text="הקיימים יוחלפו בגרסה שמועתקת" Style="{StaticResource ChoiceHint}"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource Choice}" Click="OnSkipAll"
                AutomationProperties.Name="דלג על הפריטים האלה">
            <StackPanel>
                <TextBlock Text="דלג על הפריטים האלה" Style="{StaticResource ChoiceTitle}"/>
                <TextBlock Text="היעד יישאר בדיוק כפי שהוא" Style="{StaticResource ChoiceHint}"/>
            </StackPanel>
        </Button>

        <!-- Windows has no such option at this stage: getting "keep both" out of
             its dialog costs four clicks. It is the answer that loses nothing, so
             it belongs beside the two that do. -->
        <Button Style="{StaticResource Choice}" Click="OnKeepBothAll"
                AutomationProperties.Name="שמור את שניהם">
            <StackPanel>
                <TextBlock Text="שמור את שניהם" Style="{StaticResource ChoiceTitle}"/>
                <TextBlock Text="שום דבר לא נמחק — למועתקים יתווסף מספר לשם" Style="{StaticResource ChoiceHint}"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource Choice}" Click="OnDecidePerFile"
                AutomationProperties.Name="תן לי להחליט לכל פריט">
            <StackPanel>
                <TextBlock Text="תן לי להחליט לכל פריט" Style="{StaticResource ChoiceTitle}"/>
                <TextBlock Text="השוואה זה מול זה, פריט אחר פריט" Style="{StaticResource ChoiceHint}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
